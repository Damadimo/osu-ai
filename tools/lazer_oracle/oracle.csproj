<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS0618;CS8632</NoWarn>
    <OsuDir>/Applications/osu!.app/Contents/MacOS</OsuDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="osu.Game"><HintPath>$(OsuDir)/osu.Game.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="osu.Game.Rulesets.Osu"><HintPath>$(OsuDir)/osu.Game.Rulesets.Osu.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="osu.Framework"><HintPath>$(OsuDir)/osu.Framework.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Realm"><HintPath>$(OsuDir)/Realm.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="osuTK"><HintPath>$(OsuDir)/osuTK.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
